<?xml version="1.0" encoding="utf-8"?>
<!-- Versión de desarrollo (debug): permite HTTP sin cifrar SOLO hacia 10.0.2.2, que es el ordenador
     visto desde el emulador (donde corre el backend en el puerto 7070). El resto sigue bloqueado. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
